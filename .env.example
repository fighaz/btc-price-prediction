# ============================================================================
# Konfigurasi Database — salin file ini ke .env lalu sesuaikan
# ============================================================================

# Pilih backend: sqlite (default) atau mysql
DB_BACKEND=mysql

# --- Konfigurasi MySQL (dipakai hanya kalau DB_BACKEND=mysql) ---
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
